# Maintainer: Dibs <jdibello89@gmail.com>
pkgname=chalkd
pkgver=1.1.1
pkgrel=1
pkgdesc='A touch-first infinite whiteboard for teachers'
arch=('x86_64')
url='https://github.com/DibsCodes/chalkd'
license=('GPL-3.0-or-later')
# CUPS runs the Chalkd printer (chalkd.install adds it and starts CUPS).
depends=('alsa-lib' 'cups' 'gtk3' 'nss')
makedepends=('git' 'nodejs' 'npm')
install=chalkd.install
# Electron ships its own prebuilt binaries.
options=('!strip' '!debug')
source=("git+https://github.com/DibsCodes/chalkd.git#tag=v$pkgver")
sha256sums=('SKIP')

prepare() {
  cd chalkd
  npm ci --cache "$srcdir/npm-cache"
}

build() {
  cd chalkd
  npm run package
}

package() {
  cd chalkd
  install -d "$pkgdir/usr/lib/chalkd" "$pkgdir/usr/bin"
  # Copy the contents, not the folder: forge creates it as 0700.
  cp -a out/Chalkd-linux-x64/* "$pkgdir/usr/lib/chalkd/"
  ln -s /usr/lib/chalkd/chalkd "$pkgdir/usr/bin/chalkd"

  install -Dm644 packaging/chalkd.desktop "$pkgdir/usr/share/applications/chalkd.desktop"
  for n in 16 32 48 64 128 256 512; do
    install -Dm644 "packaging/icons/chalkd-$n.png" \
      "$pkgdir/usr/share/icons/hicolor/${n}x${n}/apps/chalkd.png"
  done

  # Root-owned and not world-executable, so CUPS runs it as root (it then
  # writes each job as the user who printed it).
  install -Dm700 scripts/printer/chalkd-backend "$pkgdir/usr/lib/cups/backend/chalkd"
  install -Dm644 scripts/printer/chalkd.ppd "$pkgdir/usr/share/ppd/chalkd/chalkd.ppd"

  # Opens Chalkd when something is printed to it (see chalkd.install).
  install -Dm644 -t "$pkgdir/usr/lib/systemd/user" \
    packaging/systemd/chalkd-print.path packaging/systemd/chalkd-print.service

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
