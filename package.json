{
  "name": "chalkd",
  "productName": "Chalkd",
  "version": "1.1.1",
  "private": true,
  "description": "A touch-first infinite whiteboard for teachers",
  "keywords": [],
  "license": "GPL-3.0-or-later",
  "author": {
    "name": "Dibs",
    "email": "jdibello89@gmail.com"
  },
  "main": ".vite/build/main.cjs",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "release": "electron-forge release",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt --write",
    "typecheck": "tsc --noEmit",
    "start:x11": "electron-forge start -- --ozone-platform=x11",
    "spike": "CHALKD_SPIKE=1 electron-forge start",
    "bench": "CHALKD_BENCH=1 electron-forge start",
    "test": "vitest run",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "postinstall": "node scripts/copy-pdfjs.mjs",
    "printer:install": "sudo sh scripts/printer/install.sh",
    "printer:uninstall": "sudo sh scripts/printer/uninstall.sh"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/rbush": "^4.0.0",
    "electron": "44.7.0",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.87.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "pdfjs-dist": "^6.4.299",
    "rbush": "^4.0.1"
  }
}
